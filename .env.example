# Admin Dashboard Password
ADMIN_PASSWORD=admin123

# Database Connection (Neon / Postgres or SQLite)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Vercel Blob Token (for document uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# JWT Secret for Admin Authentication
JWT_SECRET=super-secret-key-change-in-production

# ==============================================================
# EMAIL CONFIGURATION (Choose Option 1 or Option 2)
# ==============================================================

# OPTION 1: Resend (Recommended for Next.js & Vercel — 3,000 free emails/month)
# Sign up at https://resend.com and generate an API key
RESEND_API_KEY=re_123456789...
EMAIL_FROM="IHCDT Scholarship Portal <onboarding@resend.dev>"
# (Once you verify your custom domain on Resend, change EMAIL_FROM to: "IHCDT Scholarship Portal <mail@yourdomain.org>")

# OPTION 2: Standard SMTP (Gmail, Brevo, SendGrid, Zoho, or cPanel/Webmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-16-char-app-password
# SMTP_FROM="IHCDT Scholarship Portal <your-email@gmail.com>"
